# ==========================================
# Cortex Backend Environment Configuration
# ==========================================

# PostgreSQL Settings
POSTGRES_DB=cortex_db
POSTGRES_USER=cortex_user
POSTGRES_PASSWORD=cortex_password
DATABASE_URL=postgres://cortex_user:cortex_password@localhost:5432/cortex_db

# Redis Settings (Cache, BullMQ Queue & Rate Limiting)
REDIS_URL=redis://localhost:6379

# Node / Express Server Settings
NODE_ENV=development
PORT=3000
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_random

# Google OAuth & APIs (Gmail & Google Calendar)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Default Timezone for Calendar Events (e.g., America/Sao_Paulo, UTC)
DEFAULT_TIMEZONE=America/Sao_Paulo

# AI / LLM Configuration (Default: Google Gemini 1.5 Flash for 1M context & free tier)
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

